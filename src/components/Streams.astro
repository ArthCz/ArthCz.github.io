---
import Icon from './Icon.astro';
import Clips from './Clips.astro';
import { twitch, youtube } from '../data/site.js';

const parentParams = twitch.parents.map((parent) => `parent=${encodeURIComponent(parent)}`).join('&');
const playerSrc = `https://player.twitch.tv/?channel=${twitch.channel}&${parentParams}`;
const chatSrc = `https://www.twitch.tv/embed/${twitch.channel}/chat?${parentParams}&darkpopout`;
---

<section class="section section--alt" id="transmissoes">
  <div class="container">
    <h2 class="sr-only">Transmissões e vídeos</h2>

    <div class="streams">
      <div class="panel panel--player" data-reveal>
        <div class="panel__head">
          <span class="panel__title">
            <Icon name="twitch" size={14} /> <span class="label">Twitch · {twitch.label}</span>
          </span>
          <a class="link" href={twitch.url} target="_blank" rel="noopener noreferrer">
            Abrir canal <Icon name="external" size={12} />
          </a>
        </div>

        <div class="panel__body">
          <div class="frame">
            {
              twitch.playerEmbed ? (
                <iframe
                  src={playerSrc}
                  title={`Player da Twitch do canal ${twitch.channel}`}
                  allowfullscreen
                  loading="lazy"
                />
              ) : (
                <div class="frame-fallback">
                  <p>O embed do player está desativado nas configurações.</p>
                  <a
                    class="btn btn--primary btn--sm"
                    href={twitch.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="twitch" size={14} /> Assistir na Twitch
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>

      <aside class="panel panel--chat" data-reveal>
        <div class="panel__head">
          <span class="panel__title">
            <Icon name="twitch" size={14} /> <span class="label">Chat da Twitch</span>
          </span>
          <a class="link" href={twitch.chatUrl} target="_blank" rel="noopener noreferrer">
            Abrir <Icon name="external" size={12} />
          </a>
        </div>

        <div class="panel__body">
          <div class="frame frame--tall">
            {
              twitch.chatEmbed ? (
                <iframe
                  src={chatSrc}
                  title={`Chat da Twitch do canal ${twitch.channel}`}
                  loading="lazy"
                />
              ) : (
                <div class="frame-fallback">
                  <p>O embed do chat está desativado nas configurações.</p>
                  <a
                    class="btn btn--primary btn--sm"
                    href={twitch.chatUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Abrir o chat
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </aside>

      <aside class="panel panel--wide" data-reveal>
        <div class="panel__head">
          <span class="panel__title">
            <Icon name="youtube" size={14} />
            <span class="label">YouTube · {youtube.handle}</span>
          </span>
        </div>

        <div class="panel__body panel__body--stack">
          <p class="yt__text">
            É onde ficam as lives completas, os melhores momentos e os Shorts, assim que são
            publicados.
          </p>

          <ul class="yt__list">
            <li><Icon name="check" size={13} /> Lives completas das sessões</li>
            <li><Icon name="check" size={13} /> Shorts e cortes das lives</li>
            <li><Icon name="check" size={13} /> Conteúdo de fighting games</li>
          </ul>

          <a class="btn" href={youtube.url} target="_blank" rel="noopener noreferrer">
            <Icon name="youtube" size={14} /> Abrir canal
          </a>
        </div>
      </aside>
    </div>

    <Clips />
  </div>
</section>

<style>
  .streams {
    display: grid;
    gap: 1.5rem;
  }

  .panel__body--stack {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    align-items: flex-start;
  }

  .yt__text {
    color: var(--silver-dim);
    font-size: 0.92rem;
  }

  .yt__list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: var(--silver-dim);
    font-size: 0.88rem;
  }

  .yt__list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .yt__list svg {
    flex: none;
    color: var(--crimson-2);
  }

  /* Em tela larga o chat fica do lado do player, com a mesma altura dele, e o
     YouTube ocupa a largura toda embaixo. */
  @media (min-width: 1000px) {
    .streams {
      grid-template-columns: minmax(0, 1.75fr) minmax(300px, 1fr);
    }

    .panel--player,
    .panel--chat {
      display: flex;
      flex-direction: column;
    }

    /* Quem manda na altura é o player (vídeo 16:9); o chat estica junto. */
    .panel--chat .panel__body {
      flex: 1;
      display: flex;
    }

    .panel--chat .frame {
      flex: 1;
      height: auto;
      aspect-ratio: auto;
    }

    .panel--wide {
      grid-column: 1 / -1;
    }

    .panel--wide .panel__body--stack {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
