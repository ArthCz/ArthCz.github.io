---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { site, navLinks, socials } from '../data/site.js';

const year = new Date().getFullYear();

const ICON_BY_LABEL = {
  Twitch: 'twitch',
  YouTube: 'youtube',
  Discord: 'discord',
  'X / Twitter': 'x',
  Instagram: 'instagram',
};
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <Brand />
      <p>{site.tagline}</p>
      <p class="footer__note">
        O que passa nas lives: fighting games, os clipes recentes e a comunidade da arena.
      </p>
    </div>

    <nav class="footer__col" aria-label="Navegação do rodapé">
      <h2 class="footer__title">Navegar</h2>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">Canais</h2>
      {
        socials.map((channel) =>
          channel.enabled ? (
            <a href={channel.url} target="_blank" rel="noopener noreferrer">
              <span class="footer__icon">
                <Icon name={ICON_BY_LABEL[channel.label] ?? 'arrow'} size={13} />
              </span>
              <span class="footer__label">{channel.label}</span>
              <span class="footer__handle">{channel.handle}</span>
              <span class="footer__out">
                <Icon name="external" size={11} />
              </span>
            </a>
          ) : (
            <span class="footer__pending">
              <span class="footer__label">{channel.label}</span>
              <span class="footer__handle">{channel.handle}</span>
            </span>
          ),
        )
      }
    </div>
  </div>

  <div class="container">
    <Rule />
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
    <p>
      Site independente, sem vínculo com Twitch Interactive, Inc., YouTube / Google LLC ou
      Discord Inc. Marcas citadas pertencem aos seus respectivos detentores.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-mid);
    background: var(--ink-2);
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(2.25rem, 4vw, 3rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 44ch;
  }

  .footer__brand p {
    color: var(--silver-dim);
    font-size: 0.88rem;
  }

  .footer__note {
    color: var(--silver-mute);
    font-size: 0.82rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .footer__title {
    margin-bottom: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--silver-mute);
  }

  .footer__col a,
  .footer__pending {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--silver-2);
    transition: color 0.25s var(--ease);
  }

  .footer__col a:hover {
    color: var(--silver);
  }

  .footer__col a:hover .footer__icon {
    color: var(--crimson-2);
  }

  .footer__icon,
  .footer__out {
    display: inline-flex;
    flex: none;
    color: var(--silver-mute);
  }

  .footer__icon {
    transition: color 0.25s var(--ease);
  }

  .footer__label {
    font-weight: 400;
  }

  .footer__handle {
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--silver-mute);
  }

  .footer__pending {
    color: var(--silver-mute);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 2rem;
    font-size: 0.74rem;
    color: var(--silver-mute);
  }

  .footer__bottom p {
    max-width: 62ch;
  }

  @media (min-width: 820px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
