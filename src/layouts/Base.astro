---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

const { title, description = site.description } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — Twitch, YouTube e fighting games`;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050506" />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=Pirata+One&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <Nav />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Entrada dos blocos marcados com data-reveal: o que já está na tela
      // aparece de imediato e o resto entra quando chega perto. O CSS só passa
      // a esconder depois que o observador está de pé — se qualquer coisa
      // falhar aqui, a página aparece inteira, sem animação.
      (function () {
        var alvos = document.querySelectorAll('[data-reveal]');
        if (!alvos.length || !('IntersectionObserver' in window)) return;

        var altura = window.innerHeight || document.documentElement.clientHeight;

        for (var i = 0; i < alvos.length; i += 1) {
          if (alvos[i].getBoundingClientRect().top < altura) alvos[i].classList.add('is-visible');
        }

        var observador;

        try {
          observador = new IntersectionObserver(
            function (entradas) {
              for (var k = 0; k < entradas.length; k += 1) {
                if (!entradas[k].isIntersecting) continue;
                entradas[k].target.classList.add('is-visible');
                observador.unobserve(entradas[k].target);
              }
            },
            { rootMargin: '0px 0px -6% 0px' },
          );

          for (var j = 0; j < alvos.length; j += 1) observador.observe(alvos[j]);
        } catch (erro) {
          return;
        }

        document.documentElement.classList.add('js-reveal');
      })();
    </script>
  </body>
</html>
